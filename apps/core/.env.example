# ==============================================================================
# DEUS (Core App) Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting dev or build:
#   cp .env.example .env
#
# SECURITY GUIDELINE:
# ONLY variables prefixed with VITE_ are bundled into client-side JS.
# Never place secret keys (e.g. service_role, STRIPE_SECRET_KEY, TWILIO_AUTH_TOKEN)
# into this file. Secret keys must be configured in Supabase Edge Function Secrets!
# ==============================================================================

# ── Supabase (Client-Safe) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Stripe (Client-Safe Publishable Key) ───────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_publishable_key
# or test mode:
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ── Application URL ──────────────────────────────────────────────────────────
VITE_APP_URL=https://app.infinitefuturebank.org

# ── Optional Local AI Dev ─────────────────────────────────────────────────────
# Leave empty in production to keep API keys server-side in Supabase secrets
VITE_GEMINI_API_KEY=
