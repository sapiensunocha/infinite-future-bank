# Copy this to .env and fill in your real values
# This file is safe to commit — it contains NO real keys

# Supabase — required by ALL 7 apps
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe — required by core, npo, events, wealth
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI — required by core
VITE_GEMINI_API_KEY=your_gemini_key
GROK_API_KEY=gsk_...
VITE_MICHAEL_API_KEY=your_michael_key

# Resend — required by core (email)
VITE_RESEND_API_KEY=re_...
