{
  "name": "ifb-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:core":      "npm run dev --workspace=apps/core",
    "dev:ventures":  "npm run dev --workspace=apps/ventures",
    "dev:npo":       "npm run dev --workspace=apps/npo",
    "dev:events":    "npm run dev --workspace=apps/events",
    "dev:business":  "npm run dev --workspace=apps/business",
    "dev:wealth":    "npm run dev --workspace=apps/wealth",
    "dev:admin":     "npm run dev --workspace=apps/admin",
    "build:all":     "turbo run build",
    "lint:all":      "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
